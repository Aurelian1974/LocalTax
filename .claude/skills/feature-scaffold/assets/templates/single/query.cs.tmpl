        public void Map(IEndpointRouteBuilder app) =>
            app.MapGet("/__ROUTE__", async ([AsParameters] Request request, Handler handler, CancellationToken ct) =>
                    Results.Ok(await handler.Handle(request, ct)))
               .RequireAuthorization("__POLICY__")
               .WithName("__USECASE__");
    }

    internal sealed class Handler(ISqlConnectionFactory connections)
    {
        private const string Sql = """
            -- TODO(ai): SARGable SELECT from a __MODULE__-owned table/view in [__SCHEMA__]; explicit columns; paging
            """;

        public async Task<IReadOnlyList<Row>> Handle(Request request, CancellationToken ct)
